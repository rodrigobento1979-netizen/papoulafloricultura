rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Orders collection: Anyone can create orders (storefront clients), read and update for florist operation
    match /orders/{orderId} {
      allow read, write: if true;
    }
    
    // Products catalog: readable and manageable
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Categories: readable and manageable
    match /categories/{categoryId} {
      allow read, write: if true;
    }
    
    // Customers list: readable and manageable
    match /customers/{customerId} {
      allow read, write: if true;
    }
    
    // Store configuration: readable and manageable
    match /store_config/{configId} {
      allow read, write: if true;
    }
  }
}
